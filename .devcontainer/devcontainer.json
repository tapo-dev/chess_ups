{
    "name": "KIV/UPS Bonus 2 (C++)",
    "build": {
        "dockerfile": "Dockerfile",
        "context": ".."
    },

    "customizations": {
        "vscode": {
            "extensions": [
                "ms-vscode.cpptools",
                "llvm-vs-code-extensions.vscode-clangd"
            ],
            "settings": {
                "C_Cpp.intelliSenseEngine": "disabled"
            }
        }
    },

    "containerEnv": {
        "LANG": "C.UTF-8",
        "LC_ALL": "C.UTF-8"
    },

    "forwardPorts": [10000],

    "remoteUser": "dev"
}
